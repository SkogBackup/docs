#!/bin/bash
# docs-cli - Helper script for SkogAI/docs repository operations
# Can be used directly or integrated with context generation scripts

# Set the repository root
REPO_ROOT="$HOME/SkogAI/docs/democracy/"
cd "$REPO_ROOT" || {
  echo "Error: Could not change to $REPO_ROOT"
  exit 1
}

# Display help information
show_help() {
  echo "SkogAI/docs CLI - Simplify common operations"
  echo ""
  echo "Usage: ./scripts/docs-cli COMMAND [ARGUMENTS]"
  echo ""
  echo "Commands:"
  echo "  status                    Show git status"
  echo "  last                      Show last commit"
  echo "  branches                  List all branches"
  echo "  branch                    Show current branch"
  echo "  checkout BRANCH           Checkout a branch"
  echo "  history [N]               Show last N commits (default: 5)"
  echo "  diff [FILE]               Show changes in file or repo"
  echo "  show COMMIT [FILE]        Show file contents at commit"
  echo "  view FILE                 View a file's contents"
  echo "  ls [DIR]                  List files in directory"
  echo "  create-proposal NAME      Create new proposal branch"
  echo "  create-draft NAME         Create new draft branch"
  echo "  commit [MESSAGE]          Add all files and commit with message (default: \"Update documentation\")"
  echo "  summarize                 Summarize repository state"
  echo "  quickstart                Show quickstart guide for new/reset agents"
  echo "  help                      Show this help"
  echo ""
  echo "Examples:"
  echo "  ./scripts/docs-cli last"
  echo "  ./scripts/docs-cli view workflows/pr-process.md"
  echo "  ./scripts/docs-cli create-proposal context-system"
  echo "  ./scripts/docs-cli commit \"Add documentation for context system\""
  echo ""
}

# Check if we're inside the repo
check_repo() {
  if [ ! -d ".git" ]; then
    echo "Error: Not in repository directory"
    exit 1
  fi
}

# Function to show git status
show_status() {
  check_repo
  echo "=== Repository Status ==="
  git status -s
}

# Function to show the last commit
show_last_commit() {
  check_repo
  echo "=== Last Commit ==="
  git log -1 --pretty=format:"%h - %an, %ar : %s"
}

# Function to list all branches
list_branches() {
  check_repo
  echo "=== Branches ==="
  echo "* = current branch"
  git branch -a
}

# Function to show current branch
show_current_branch() {
  check_repo
  echo "=== Current Branch ==="
  git branch --show-current
}

# Function to checkout a branch
checkout_branch() {
  check_repo
  if [ -z "$1" ]; then
    echo "Error: No branch specified"
    exit 1
  fi
  echo "=== Checking out $1 ==="
  git checkout "$1"
}

# Function to show commit history
show_history() {
  check_repo
  local count=${1:-5}
  echo "=== Last $count Commits ==="
  git log -n "$count" --pretty=format:"%h - %an, %ar : %s"
}

# Function to show changes
show_diff() {
  check_repo
  echo "=== Changes ==="
  if [ -z "$1" ]; then
    git diff --stat
    echo ""
    echo "For full diff, use 'git diff'"
  else
    git diff "$1"
  fi
}

# Function to show file at commit
show_commit_file() {
  check_repo
  if [ -z "$1" ]; then
    echo "Error: No commit specified"
    exit 1
  fi
  if [ -z "$2" ]; then
    git show "$1"
  else
    echo "=== $2 at commit $1 ==="
    git show "$1":"$2"
  fi
}

# Function to view a file
view_file() {
  if [ -z "$1" ]; then
    echo "Error: No file specified"
    exit 1
  fi
  if [ ! -f "$1" ]; then
    echo "Error: File $1 not found"
    exit 1
  fi
  echo "=== $1 ==="
  cat "$1"
}

# Function to list directory contents
list_dir() {
  local dir=${1:-.}
  echo "=== Contents of $dir ==="
  ls -la "$dir"
}

# Function to create a proposal branch
create_proposal() {
  check_repo
  if [ -z "$1" ]; then
    echo "Error: No proposal name specified"
    exit 1
  fi
  local branch_name="proposal/$1"
  echo "=== Creating proposal branch: $branch_name ==="
  git checkout -b "$branch_name" master
  echo ""
  echo "Proposal branch created! You can now make changes."
  echo "Remember to follow the documentation templates."
}

# Function to create a draft branch
create_draft() {
  check_repo
  if [ -z "$1" ]; then
    echo "Error: No draft name specified"
    exit 1
  fi
  local branch_name="draft/$1"
  echo "=== Creating draft branch: $branch_name ==="
  git checkout -b "$branch_name" master
  echo ""
  echo "Draft branch created! You can now make changes."
}

# Function to summarize repository state
summarize_repo() {
  check_repo
  echo "=== SkogAI/docs Repository Summary ==="
  echo ""
  echo "Current branch: $(git branch --show-current)"
  echo ""
  echo "Recent commits:"
  git log -n 3 --pretty=format:"%h - %an, %ar : %s"
  echo ""
  echo ""
  echo "Available branches:"
  git branch -a
  echo ""
  echo "Repository status:"
  git status -s
  echo ""
  echo "Main directories:"
  ls -d */ 2>/dev/null || echo "No directories found"
}

# Function to commit changes
commit_changes() {
  check_repo
  local message=${1:-"Update documentation"}
  echo "=== Committing changes ==="
  git add .
  git commit -m "$message"
  echo "Changes committed with message: $message"
}

# Function to show quickstart guide
show_quickstart() {
  if [ -f "QUICKSTART.md" ]; then
    echo "=== SkogAI/docs Quickstart Guide ==="
    echo ""
    cat "QUICKSTART.md"
  else
    echo "Error: QUICKSTART.md not found"
    exit 1
  fi
}

# Parse command line arguments
case "$1" in
status)
  show_status
  ;;
last)
  show_last_commit
  ;;
branches)
  list_branches
  ;;
branch)
  show_current_branch
  ;;
checkout)
  checkout_branch "$2"
  ;;
history)
  show_history "$2"
  ;;
diff)
  show_diff "$2"
  ;;
show)
  show_commit_file "$2" "$3"
  ;;
view)
  view_file "$2"
  ;;
ls)
  list_dir "$2"
  ;;
create-proposal)
  create_proposal "$2"
  ;;
create-draft)
  create_draft "$2"
  ;;
commit)
  commit_changes "$2"
  ;;
summarize)
  summarize_repo
  ;;
quickstart)
  show_quickstart
  ;;
help | --help | -h)
  show_help
  ;;
*)
  echo "Unknown command: $1"
  echo ""
  show_help
  exit 1
  ;;
esac

exit 0
